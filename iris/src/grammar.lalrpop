use crate::ast::{
    Body, ConcreteTerm, ConcreteTermKind, Definition, Expr, Extern, GlobalKind, Guard, IntType,
    Let, Literal, OverloadTerm, Pattern, Rule, Term, Type,
};
use crate::lexer::Token;
use lalrpop_util::ParseError;

grammar;

extern {
    type Location = usize;
    type Error = ();

    enum Token {
        "const" => Token::Const,
        "extern" => Token::Extern,
        "false" => Token::False,
        "field" => Token::Field,
        "if" => Token::If,
        "let" => Token::Let,
        "multi" => Token::Multi,
        "overload" => Token::Overload,
        "partial" => Token::Partial,
        "pure" => Token::Pure,
        "rule" => Token::Rule,
        "term" => Token::Term,
        "total" => Token::Total,
        "true" => Token::True,
        "type" => Token::Type,

        "ident" => Token::Ident(<String>),
        "integer" => Token::Integer(<i64>),

        "&&" => Token::And,
        "->" => Token::Arrow,
        "=" => Token::Assign,
        ":" => Token::Colon,
        "," => Token::Comma,
        "." => Token::Dot,
        "{" => Token::LeftBracket,
        "(" => Token::LeftParen,
        "-" => Token::Minus,
        "+" => Token::Plus,
        "}" => Token::RightBracket,
        ")" => Token::RightParen,
        ";" => Token::Semicolon,
        "_" => Token::Underscore,
    }
}

Separated<S, T>: Vec<T> = {
    <mut v: (<T> S)*> <e: T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);

            v
        }
    }
};

Comma<T> = Separated<",", T>;

pub(crate) Definitions: Vec<Definition> = <Definition*>;

Definition: Definition = {
    <Term> ";" => Definition::Term(<>),
    <Extern> ";" => Definition::Extern(<>),
    Rule => Definition::Rule(<>),
};

Term: Term = {
    ConcreteTerm => Term::Concrete(<>),
    OverloadTerm => Term::Overload(<>),
};

ConcreteTerm: ConcreteTerm = <pure: "pure"?> <kind: ConcreteTermKind> "term" <name: "ident"> "(" <arg_tys: Comma<Type>> ")" "->" <ret_ty: Type> =>
    ConcreteTerm {
        kind,
        name,
        arg_tys,
        ret_ty,
        is_pure: pure.is_some(),
    };

ConcreteTermKind: ConcreteTermKind = {
    "partial" => ConcreteTermKind::Partial,
    "total" => ConcreteTermKind::Total,
    "multi" => ConcreteTermKind::Multi,
};

Type: Type = {
    "(" <Comma<Type>> ")" => Type::Tuple(<>),
    "ident" => Type::Ident(<>),
};

OverloadTerm: OverloadTerm = "overload" "term" <name: "ident"> "=" <terms: Separated<"+", "ident">> => OverloadTerm {<>};

Extern: Extern = {
    "extern" "type" <name: "ident"> <external_name: ("=" <"ident">)?> => Extern::Type {<>},
    "extern" <term: ConcreteTerm> <external_name: ("=" <"ident">)?> => Extern::Term {<>},
    "extern" "let" <name: "ident"> ":" <ty: Type> "=" <kind: GlobalKind> <external_name: "ident"> => Extern::Global {<>},
};

GlobalKind: GlobalKind = {
    "const" => GlobalKind::Const,
    "field" => GlobalKind::Field,
};

Rule: Rule = "rule" <pat: Pattern> <guards: ("if" <Separated<"&&", Guard>>)?> "{" <body: Body> "}" =>
    Rule {
        pat,
        guards: guards.unwrap_or_default(),
        body,
    };

Pattern: Pattern = {
    <name: "ident"> "(" <args: Comma<Pattern>> ")" => Pattern::Application {<>},
    "(" <Comma<Pattern>> ")" => Pattern::Tuple(<>),
    Literal => Pattern::Literal(<>),
    "ident" => Pattern::Ident(<>),
    "_" => Pattern::Wildcard,
};

Guard: Guard = "let" <pat:Pattern> "=" <expr: Expr> => Guard {<>};

Expr: Expr = {
    <name: "ident"> "(" <args: Comma<Expr>> ")" => Expr::Call {<>},
    "(" <Comma<Expr>> ")" => Expr::Tuple(<>),
    <expr: Expr> "." <idx: "integer"> =>
        Expr::TupleIndex {
            expr: Box::new(expr),
            idx: idx.try_into().unwrap(),
        },
    Literal => Expr::Literal(<>),
    "ident" => Expr::Ident(<>),
};

Literal: Literal = {
    <negative: "-"?> <value: "integer"> <ty: IntType?>  =>
        Literal::Int{
            value: if negative.is_some() { -value } else { value },
            ty,
        },
    "true" => Literal::Bool(true),
    "false" => Literal::Bool(false),
};

IntType: IntType = {
    <ident: "ident"> =>? match ident.as_str() {
        "i8" => Ok(IntType::I8),
        "i16" => Ok(IntType::I16),
        "i32" => Ok(IntType::I32),
        "i64" => Ok(IntType::I64),
        "isize" => Ok(IntType::Isize),
        "u8" => Ok(IntType::U8),
        "u16" => Ok(IntType::U16),
        "u32" => Ok(IntType::U32),
        "u64" => Ok(IntType::U64),
        "usize" => Ok(IntType::Usize),
        _ => Err(ParseError::from(())),
    }
};

Body: Body = <lets: Let*> <expr: Expr> => Body {<>};

Let: Let = "let" <name: "ident"> ":" <ty: Type> "=" <value: Expr> ";" => Let {<>};
